<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline harness for the scoring core: rule tests and replays of research logs. No Unity, no game needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Stylemeter.Sim</RootNamespace>
    <!-- Some core fields are only filled by the game side (wall cling, death, bosses), which is not built here. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Stylemeter\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
